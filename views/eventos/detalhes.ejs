<%- include('../partials/header') %>

<div class="detalhes-evento">
  <h1><%= evento.titulo %></h1>
  <p><%= evento.descricao %></p>
  <p><strong>📍 Local:</strong> <%= evento.local_evento %></p>
  <p><strong>📅 Data:</strong> <%= new Date(evento.data_evento).toLocaleDateString('pt-BR') %></p>

  <% if (jaInscrito) { %>
    <p class="badge-sucesso">✅ Você já está inscrito neste evento!</p>
  <% } else { %>
    <form method="POST" action="/eventos/<%= evento.id_evento %>/inscrever">
      <button type="submit">Inscrever-se</button>
    </form>
  <% } %>

  <% if (user && user.id === evento.id_organizador) { %>
    <div class="acoes-organizador">
      <a href="/eventos/<%= evento.id_evento %>/editar">Editar</a>
      <form method="POST" action="/eventos/<%= evento.id_evento %>/deletar" style="display:inline">
        <button type="submit" onclick="return confirm('Tem certeza que deseja excluir?')">Excluir</button>
      </form>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>